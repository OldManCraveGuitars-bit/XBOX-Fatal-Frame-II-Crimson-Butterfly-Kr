--- /dev/null
+++ b/tests/hle/test_region_writes.c
@@ -0,0 +1,34 @@
+#include "hw/xbox/hle/pb/region_writes.h"
+#include <assert.h>
+#include <stdio.h>
+
+int main(void)
+{
+    HleRegionWrites h = {0};
+    HleWriteRect all = {0,0,320,480}, top = {0,0,320,240}, bottom = {0,240,320,480};
+    hle_region_write(&h,all,100);
+    /* FFII: the bottom alias is written at 110. Later blur draws only
+     * affect the parent's top 240 rows. They must not supersede that alias. */
+    hle_region_write(&h,top,120);
+    assert(hle_region_written(&h,bottom) == 100);
+    assert(hle_region_written(&h,bottom) <= 110);
+    assert(hle_region_written(&h,top) == 120);
+    hle_region_write(&h,bottom,130);
+    assert(hle_region_written(&h,bottom) > 110);
+    /* A real parent write across the boundary still invalidates the part. */
+    hle_region_write(&h,(HleWriteRect){0,239,320,241},140);
+    assert(hle_region_written(&h,bottom) == 140);
+    for (unsigned i=0; i<1000; i++) hle_region_write(&h,top,200+i);
+    assert(h.n == 4);
+    assert(hle_region_written(&h,bottom) == 140);
+    hle_region_write(&h,(HleWriteRect){0,0,0,480},9999);
+    assert(hle_region_written(&h,top) == 1199);
+    assert(hle_region_written(&h,(HleWriteRect){20,0,20,100}) == 0);
+    /* Full history: evicted writes remain conservative for every alias. */
+    HleRegionWrites full = {0};
+    for (unsigned i=0; i<17; i++)
+        hle_region_write(&full,(HleWriteRect){(int)i,0,(int)i+1,1},i+1);
+    assert(full.n == HLE_REGION_WRITES_MAX);
+    assert(hle_region_written(&full,(HleWriteRect){0,0,1,1}) >= 1);
+    puts("region-write regression checks passed");
+}
