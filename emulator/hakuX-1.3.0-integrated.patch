+        const int32_t h = MIN(r->y2 - r->y1, (int32_t)dst->d.h - c->y[i]);
+        if (r->x1 < 0 || r->y1 < 0 || c->x[i] < 0 || c->y[i] < 0 || w <= 0 || h <= 0 ||
