+/* SPDX-License-Identifier: GPL-3.0-or-later */
+#ifndef HLE_REGION_WRITES_H
+#define HLE_REGION_WRITES_H
+#include <stdint.h>
+
+/* Conservative write history for aliases of part of an image. An image-wide
+ * sequence alone lets a write to its top half overwrite a newer bottom-half
+ * alias. Identical clip rectangles coalesce; eviction falls back to treating
+ * the evicted sequence as image-wide, never to missing an actual write. */
+#define HLE_REGION_WRITES_MAX 16
+typedef struct HleWriteRect { int32_t x1, y1, x2, y2; } HleWriteRect;
+typedef struct HleRegionWrites {
+    uint64_t floor;
+    unsigned n;
+    struct { HleWriteRect r; uint64_t seq; } e[HLE_REGION_WRITES_MAX];
+} HleRegionWrites;
+
+static inline void hle_region_write(HleRegionWrites *h, HleWriteRect r, uint64_t seq)
+{
+    if (r.x1 >= r.x2 || r.y1 >= r.y2) return;
+    unsigned at = h->n;
+    for (unsigned i = 0; i < h->n; i++) {
+        HleWriteRect q = h->e[i].r;
+        if (q.x1 == r.x1 && q.y1 == r.y1 && q.x2 == r.x2 && q.y2 == r.y2) {
+            at = i;
+            break;
+        }
+    }
+    if (at == HLE_REGION_WRITES_MAX) {
+        at = 0;
+        for (unsigned i = 1; i < h->n; i++)
+            if (h->e[i].seq < h->e[at].seq) at = i;
+        if (h->e[at].seq > h->floor) h->floor = h->e[at].seq;
+    } else if (at == h->n) {
+        h->n++;
+    }
+    h->e[at].r = r;
+    h->e[at].seq = seq;
+}
+
+static inline uint64_t hle_region_written(const HleRegionWrites *h, HleWriteRect r)
+{
+    if (r.x1 >= r.x2 || r.y1 >= r.y2) return 0;
+    uint64_t seq = h->floor;
+    for (unsigned i = 0; i < h->n; i++) {
+        HleWriteRect q = h->e[i].r;
+        if (q.x1 < r.x2 && r.x1 < q.x2 && q.y1 < r.y2 && r.y1 < q.y2 && h->e[i].seq > seq)
+            seq = h->e[i].seq;
+    }
+    return seq;
+}
+#endif
